# ── MongoDB ────────────────────────────────────────────────────────────────
# For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?appName=app
# For local Docker:  mongodb://mongodb:27017/
MONGODB_URI=mongodb+srv://giri:Giri77085.@giri.ifbrbc5.mongodb.net/?appName=giri
MONGODB_DATABASE=healthcare_db
COLLECTION_PRESCRIPTIONS=prescriptions
COLLECTION_ALLERGIES=allergies
FORCE_MOCK_DB=false
RUN_DB_SEED_ON_STARTUP=true

# ── App ────────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO

# ── AI ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MEDGEMMA_API_URL=http://host.docker.internal:8000/v1

# ── Polygon Blockchain ─────────────────────────────────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
POLYGON_CONTRACT_ADDRESS=
TEST_DOCTOR_PRIVATE_KEY=
TEST_PHARMACY_PRIVATE_KEY=

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for development
CORS_ORIGINS=*

# ── Prescription rules ─────────────────────────────────────────────────────
DUPLICATE_TOLERANCE_DAYS=30
PRESCRIPTION_HISTORY_DAYS=90

# ── Internal service URLs (used by gateway in Docker) ──────────────────────
AUTH_SERVICE_URL=http://auth-service:4001
PATIENT_SERVICE_URL=http://patient-service:4002
CONSULTATION_SERVICE_URL=http://consultation-service:4003
PRESCRIPTION_SERVICE_URL=http://prescription-service:4004
AUDIT_SERVICE_URL=http://audit-service:4005
PHARMACY_SERVICE_URL=http://pharmacy-service:4006
LEDGER_SERVICE_URL=http://ledger-service:4007
